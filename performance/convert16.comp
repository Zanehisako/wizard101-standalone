#version 450
layout(local_size_x=256) in;
// Reserved slots avoid overwriting any D3D9 graphics resource bindings.
layout(binding=1214,std430) readonly buffer Source { uint words[]; } src;
layout(binding=1215,std430) writeonly buffer Destination { uint pixels[]; } dst;
void main() {
  uint index=gl_GlobalInvocationID.x, width=src.words[0], height=src.words[1];
  if(index>=width*height) return;
  uint offset=(index/width)*src.words[2]+index%width;
  uint p=(src.words[4+offset/2]>>((offset&1)*16))&65535;
  uint mode=src.words[3], a,r,g,b;
  if(mode<2) { a=mode==1?255:(p>>12)*17; r=((p>>8)&15)*17; g=((p>>4)&15)*17; b=(p&15)*17; }
  else if(mode<4) { a=(mode==3 || (p&32768)!=0)?255:0; r=(p>>10)&31; g=(p>>5)&31; b=p&31; r=(r<<3)|(r>>2); g=(g<<3)|(g>>2); b=(b<<3)|(b>>2); }
  else { a=255; r=(p>>11)&31; g=(p>>5)&63; b=p&31; r=(r<<3)|(r>>2); g=(g<<2)|(g>>4); b=(b<<3)|(b>>2); }
  dst.pixels[index]=(a<<24)|(r<<16)|(g<<8)|b;
}
