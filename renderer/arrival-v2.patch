+  void D3D9DeviceEx::InitializeSceneTexture(D3D9CommonTexture* resource) {
+    const uint32_t pending=resource->m_arrivalInitPending;
+    if(!pending) return;
+    auto image=resource->PeekImage();
+    EmitCs([image,pending](DxvkContext* ctx) {
+      const auto aspect=lookupFormatInfo(image->info().format)->aspectMask;
+      if(pending==((1u<<image->info().mipLevels)-1)) {
+        ctx->initImage(image,{aspect,0,image->info().mipLevels,0,1},VK_IMAGE_LAYOUT_UNDEFINED);
+      } else for(uint32_t mip:bit::BitMask(pending))
+        ctx->initImage(image,{aspect,mip,1,0,1},VK_IMAGE_LAYOUT_UNDEFINED);
+    });
+    resource->m_arrivalInitPending=0;
+  }
+
   void D3D9DeviceEx::UploadManagedTexture(D3D9CommonTexture* pResource) {
-    if(m_sceneTextures && ReuseSceneUpload(pResource)) return;
+    bool complete=pResource->m_arrivalInitPending && !pResource->m_arrivalPartial
+      && !pResource->IsAnySubresourceLocked()
+      && pResource->m_arrivalWritten==((1u<<pResource->Desc()->MipLevels)-1);
+    const auto& box=pResource->GetDirtyBox(0);
+    complete=complete && box.Left==0 && box.Top==0 && box.Front==0
+      && box.Right==pResource->Desc()->Width && box.Bottom==pResource->Desc()->Height && box.Back==1;
+    for(uint32_t mip=0;complete && mip<pResource->Desc()->MipLevels;mip++)
+      complete=pResource->NeedsUpload(mip);
+    // Suppress clearing only while queuing a proven complete mip chain. Each
+    // successful command retires its pending mip; exceptions clear uncovered mips.
+    pResource->m_arrivalFullOverwrite=complete;
+    struct Finish {
+      D3D9CommonTexture* texture;
+      ~Finish() { texture->m_arrivalFullOverwrite=false; }
+    } finish{pResource};
+    if(!complete) pResource->EnsureGpuInitialized();
+    if(m_sceneTextures && ReuseSceneUpload(pResource)) {
+      pResource->m_arrivalInitPending=0;return;
+    }
     for (uint32_t subresource = 0; subresource < pResource->CountSubresources(); subresource++) {
       if (!pResource->NeedsUpload(subresource))
         continue;
 
       this->FlushImage(pResource, subresource);
+      pResource->m_arrivalInitPending &= ~(1u<<subresource);
     }
 
     pResource->ClearDirtyBoxes();
