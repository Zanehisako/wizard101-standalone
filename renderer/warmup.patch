new file mode 100644
index 0000000..b386fa0
--- /dev/null
+++ b/src/util/util_warmup.h
@@ -0,0 +1,64 @@
+#pragma once
+#include "thread.h"
+
+namespace dxvk {
+  // Foreground requests never wait for this gate. Only queued background work
+  // waits; a driver call already in flight cannot safely be preempted.
+  class WarmupGate {
+  public:
+    explicit WarmupGate(bool enabled) : m_enabled(enabled) { }
+    class Foreground {
+    public:
+      explicit Foreground(WarmupGate& gate, bool request = true)
+      : m_gate(gate), m_active(gate.m_enabled && request) {
+        if (m_active) {
+          std::lock_guard<dxvk::mutex> lock(m_gate.m_lock);
+          ++m_gate.m_foreground;
+        }
+      }
+      ~Foreground() {
+        if (m_active) {
+          std::lock_guard<dxvk::mutex> lock(m_gate.m_lock);
+          --m_gate.m_foreground; m_gate.m_cond.notify_all();
+        }
+      }
+    private:
+      WarmupGate& m_gate;
+      const bool m_active;
+    };
+    class Background {
+    public:
+      explicit Background(WarmupGate& gate, bool request = true)
+      : m_gate(gate), m_active(gate.m_enabled && request) {
+        if (!m_active) { m_acquired = true; return; }
+        std::unique_lock<dxvk::mutex> lock(m_gate.m_lock);
+        m_gate.m_cond.wait(lock, [&] {
+          return m_gate.m_stop || (!m_gate.m_foreground && !m_gate.m_background);
+        });
+        m_acquired = !m_gate.m_stop;
+        if (m_acquired) m_gate.m_background = true;
+      }
+      ~Background() {
+        if (m_active && m_acquired) {
+          std::lock_guard<dxvk::mutex> lock(m_gate.m_lock);
+          m_gate.m_background = false; m_gate.m_cond.notify_all();
+        }
+      }
+      explicit operator bool() const { return m_acquired; }
+    private:
+      WarmupGate& m_gate;
+      const bool m_active;
+      bool m_acquired = false;
+    };
+    void stop() {
+      std::lock_guard<dxvk::mutex> lock(m_lock);
+      m_stop = true; m_cond.notify_all();
+    }
+  private:
+    const bool m_enabled;
+    dxvk::mutex m_lock;
+    dxvk::condition_variable m_cond;
+    uint32_t m_foreground = 0;
+    bool m_background = false, m_stop = false;
+  };
+}
