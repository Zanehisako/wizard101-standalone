diff --git a/src/d3d9/d3d9_warmup.cpp b/src/d3d9/d3d9_warmup.cpp
new file mode 100644
index 0000000..aa40c60
--- /dev/null
+++ b/src/d3d9/d3d9_warmup.cpp
@@ -0,0 +1,144 @@
+#include "d3d9_warmup.h"
+#include "../util/util_profile.h"
+#include "../util/util_env.h"
+#include "../util/log/log.h"
+#include <cstring>
+
+namespace dxvk {
+  namespace {
+    using Clock = std::chrono::steady_clock;
+    bool valid(const W101ShaderCatalog::Record& r) {
+      if (r.words.size() < 2 || r.words.size() * 4 > W101ShaderCatalog::MaxShaderBytes) return false;
+      // The bounded DXSO reader validates instruction/operand boundaries later.
+      const auto type = r.words.front() >> 16;
+      return ((r.stage == 1 && type == 0xfffe) || (r.stage == 16 && type == 0xffff))
+          && r.words.back() == 0x0000ffff;
+    }
+  }
+  bool W101ShaderCatalog::decode(const std::vector<char>& data, std::vector<Record>& records) {
+    records.clear();
+    if (data.size() < 4 || data.size() > MaxBytes) return false;
+    uint32_t count; std::memcpy(&count, data.data(), 4);
+    if (count > MaxShaders) return false;
+    size_t offset = 4;
+    for (uint32_t i = 0; i < count; i++) {
+      if (offset + 8 > data.size()) return false;
+      uint32_t stage, bytes;
+      std::memcpy(&stage, data.data() + offset, 4);
+      std::memcpy(&bytes, data.data() + offset + 4, 4); offset += 8;
+      if (bytes < 8 || bytes % 4 || bytes > MaxShaderBytes || bytes > data.size() - offset) return false;
+      Record r { stage, std::vector<uint32_t>(bytes / 4) };
+      std::memcpy(r.words.data(), data.data() + offset, bytes); offset += bytes;
+      if (valid(r)) records.push_back(std::move(r)); // Ignore individually invalid shaders.
+    }
+    return offset == data.size();
+  }
+  std::vector<char> W101ShaderCatalog::encode(const std::vector<Record>& records) {
+    std::vector<char> data(4); uint32_t count = 0;
+    for (const auto& r : records) {
+      if (!valid(r) || count == MaxShaders || data.size() + 8 + r.words.size() * 4 > MaxBytes) continue;
+      const uint32_t bytes = r.words.size() * 4;
+      const size_t offset = data.size(); data.resize(offset + 8 + bytes);
+      std::memcpy(data.data() + offset, &r.stage, 4);
+      std::memcpy(data.data() + offset + 4, &bytes, 4);
+      std::memcpy(data.data() + offset + 8, r.words.data(), bytes); ++count;
+    }
+    std::memcpy(data.data(), &count, 4); return data;
+  }
+  W101ShaderCatalog::W101ShaderCatalog(std::string path, Sha1Hash key, bool warm,
+    Restore restore, std::function<bool()> busy)
+  : m_path(std::move(path)), m_key(key), m_warm(warm),
+    m_restore(std::move(restore)), m_busy(std::move(busy)) {
+    m_thread = dxvk::thread([this] {
+      try { worker(); }
+      catch (const std::exception& e) { Logger::warn(str::format("W101 catalog unavailable: ", e.what())); }
+      std::lock_guard<dxvk::mutex> lock(m_lock);
+      m_warmDone = true; m_cond.notify_all();
+    });
+    m_thread.set_priority(ThreadPriority::Lowest);
+  }
+  W101ShaderCatalog::~W101ShaderCatalog() { stop(); }
+  bool W101ShaderCatalog::add(Record&& r) {
+    const auto key = std::to_string(r.stage) + Sha1Hash::compute(r.words.data(), r.words.size() * 4).toString();
+    if (m_known.count(key) || m_records.size() == MaxShaders || m_bytes + 8 + r.words.size() * 4 > MaxBytes) return false;
+    m_known.emplace(key, m_records.size()); m_bytes += 8 + r.words.size() * 4;
+    m_records.push_back(std::move(r)); return true;
+  }
+  void W101ShaderCatalog::record(uint32_t stage, const void* data, uint32_t bytes) {
+    if (bytes < 8 || bytes % 4 || bytes > MaxShaderBytes || m_stop.load()) return;
+    // No disk writes or waits on the shader-creation path. At capacity we
+    // retain the learned catalog; a missed record can be learned next launch.
+    std::unique_lock<dxvk::mutex> lock(m_lock, std::try_to_lock);
+    if (!lock.owns_lock() || !m_ready || m_records.size() == MaxShaders || m_bytes + 8 + bytes > MaxBytes) return;
+    Record r { stage, std::vector<uint32_t>(bytes / 4) };
+    std::memcpy(r.words.data(), data, bytes);
+    if (valid(r) && add(std::move(r))) {
+      m_dirty = true; m_last = Clock::now(); m_cond.notify_all();
+    }
+  }
+  void W101ShaderCatalog::waitStartup() {
+    if (!m_warm) return;
+    ProfileScope profile("shader_warmup_startup_wait");
+    const auto begin = Clock::now();
+    const auto deadline = begin + std::chrono::seconds(10);
+    std::unique_lock<dxvk::mutex> lock(m_lock);
+    m_cond.wait_until(lock, deadline, [this] { return m_warmDone || m_stop.load(); });
+    Logger::info(str::format("W101 startup warm-up ", m_warmDone ? "complete" : "budget reached",
+      "; restored ", m_restored.load(), " shaders in ",
+      std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - begin).count(),
+      " ms", m_warmDone ? "" : "; remaining preparation runs in background"));
+  }
+  void W101ShaderCatalog::save() {
+    std::vector<Record> records;
+    { std::lock_guard<dxvk::mutex> lock(m_lock);
+      if (!m_dirty) return;
+      records = m_records; m_dirty = false;
+    }
+    ProfileScope profile("shader_catalog_write");
+    if (!cachefile::write(m_path, m_key, encode(records))) {
+      Logger::warn("W101 catalog persistence unavailable; rendering continues");
+      // Do not repeatedly retry permanent storage failures this launch.
+      m_path.clear();
+    }
+  }
+  void W101ShaderCatalog::worker() {
+    env::setThreadName("w101-shader-catalog");
+    std::vector<char> data; std::vector<Record> restored;
+    bool loaded;
+    { ProfileScope profile("shader_catalog_read");
+      loaded = cachefile::read(m_path, m_key, data) && decode(data, restored);
+    }
+    if (!loaded) restored.clear();
+    { std::lock_guard<dxvk::mutex> lock(m_lock);
+      for (auto& r : restored) add(Record { r.stage, r.words });
+      m_ready = true;
+    }
+    Logger::info(str::format("W101 catalog ", loaded ? "loaded: " : "empty/incompatible: ", restored.size(), " shaders; warm-up ", m_warm ? "on" : "off"));
+    if (m_warm) {
+      for (const auto& r : restored) {
+        if (m_stop.load()) break;
+        try { ProfileScope profile("shader_catalog_restore"); m_restore(r); ++m_restored; }
+        catch (const std::exception&) { Logger::warn("W101 catalog shader ignored; foreground compilation remains available"); }
+      }
+      std::unique_lock<dxvk::mutex> lock(m_lock);
+      while (!m_stop.load() && m_busy()) m_cond.wait_for(lock, std::chrono::milliseconds(10));
+    }
+    { std::lock_guard<dxvk::mutex> lock(m_lock); m_warmDone = true; m_cond.notify_all(); }
+    while (!m_stop.load()) {
+      std::unique_lock<dxvk::mutex> lock(m_lock);
+      m_cond.wait(lock, [this] { return m_stop.load() || (m_dirty && !m_path.empty()); });
+      if (m_stop.load()) break;
+      const auto last = m_last;
+      if (m_cond.wait_until(lock, last + std::chrono::seconds(5), [this, last] { return m_stop.load() || m_last != last; })) continue;
+      lock.unlock(); save();
+    }
+    if (!m_path.empty()) save();
+  }
+  void W101ShaderCatalog::stop() {
+    m_stop.store(true);
+    { std::lock_guard<dxvk::mutex> lock(m_lock); m_cond.notify_all(); }
+    if (m_thread.joinable()) {
+      if (this_thread::isInModuleDetachment()) m_thread.detach(); else m_thread.join();
+    }
+  }
+}
diff --git a/src/d3d9/d3d9_warmup.h b/src/d3d9/d3d9_warmup.h
new file mode 100644
index 0000000..8eff2fc
--- /dev/null
+++ b/src/d3d9/d3d9_warmup.h
@@ -0,0 +1,46 @@
+#pragma once
+#include "../util/util_cache_file.h"
+#include "../util/thread.h"
+#include <atomic>
+#include <functional>
+#include <unordered_map>
+
+namespace dxvk {
+  // Private local bytecode catalog; never shipped as fixtures or source.
+  // A fixed filename bounds storage across translation/driver revisions.
+  class W101ShaderCatalog {
+  public:
+    static constexpr size_t MaxShaders = 2048;
+    static constexpr size_t MaxShaderBytes = 64 * 1024;
+    static constexpr size_t MaxBytes = 32 * 1024 * 1024;
+    struct Record { uint32_t stage; std::vector<uint32_t> words; };
+    using Restore = std::function<void(const Record&)>;
+    W101ShaderCatalog(std::string path, Sha1Hash key, bool warm,
+      Restore restore, std::function<bool()> busy);
+    ~W101ShaderCatalog();
+    void record(uint32_t stage, const void* data, uint32_t bytes);
+    void waitStartup();
+    void stop();
+    static bool decode(const std::vector<char>& data, std::vector<Record>& records);
+    static std::vector<char> encode(const std::vector<Record>& records);
+  private:
+    std::string m_path;
+    Sha1Hash m_key;
+    bool m_warm;
+    Restore m_restore;
+    std::function<bool()> m_busy;
+    dxvk::mutex m_lock;
+    dxvk::condition_variable m_cond;
+    dxvk::thread m_thread;
+    std::atomic<bool> m_stop { false };
+    std::atomic<uint32_t> m_restored { 0 };
+    bool m_ready = false, m_warmDone = false, m_dirty = false;
+    size_t m_bytes = 4;
+    std::vector<Record> m_records;
+    std::unordered_map<std::string, size_t> m_known;
+    std::chrono::steady_clock::time_point m_last;
+    void worker();
+    void save();
+    bool add(Record&& record);
+  };
+}
