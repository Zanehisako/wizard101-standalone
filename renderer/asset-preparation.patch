+  void D3D9DeviceEx::PrepareKnownAssets() {
+    const DWORD incoming = GetLastError();
+    if (auto cache = wizard101::assetCache(this)) {
+      try {
+        cache->configure(this);
+        if (wizard101::feature("W101_PREPARE_ASSETS")) {
+          cache->load();
+          cache->prepare(this,
+            [](IDirect3DTexture9* t) { static_cast<D3D9Texture2D*>(t)->AddRefPrivate(); },
+            [](IDirect3DTexture9* t) { static_cast<D3D9Texture2D*>(t)->ReleasePrivate(); });
+          Flush();
+          SynchronizeCsThread(DxvkCsThread::SynchronizeAll);
+          m_dxvkDevice->waitForIdle();
+          cache->markReady();
+          Logger::info(str::format("W101 known assets: prepared=", cache->preparedCount.load(), " upload_complete=1 cutoff=none budget_bytes=", wizard101::assetBytes.load()));
+        }
+      } catch (...) {
+        cache->clear();
+        Logger::warn("W101 known assets unavailable; native paths retained");
+      }
+    }
+    SetLastError(incoming);
+  }
