diff --git a/src/util/util_profile.cpp b/src/util/util_profile.cpp
new file mode 100644
index 00000000..66ceeb0d
--- /dev/null
+++ b/src/util/util_profile.cpp
@@ -0,0 +1,96 @@
+#include "util_profile.h"
+#include "util_env.h"
+#include "thread.h"
+#include <atomic>
+#include <fstream>
+#include <vector>
+
+namespace dxvk {
+  std::atomic<int32_t> profileState { -1 };
+  namespace {
+    using Clock = std::chrono::steady_clock;
+    struct Event { const char* name; uint32_t tid; int64_t start, duration; };
+    class Recorder {
+    public:
+      Clock::time_point origin;
+      Recorder() {
+        const auto path = env::getEnvVar("DXVK_W101_PROFILE");
+        if (path.empty()) { profileState.store(0); return; }
+        file.open(path, std::ios::trunc | std::ios::binary);
+        if (!file) { profileState.store(0); return; }
+        file << "event,thread,start_us,duration_us\n";
+        origin = Clock::now();
+        pending.reserve(8192);
+        profileState.store(1);
+        try { worker = dxvk::thread([this] {
+          try { write(); } catch (...) { profileState.store(0); }
+        }); }
+        catch (...) { profileState.store(0); file.close(); }
+      }
+      void shutdown() {
+        profileState.store(0);
+        { std::lock_guard<dxvk::mutex> guard(lock); stop = true; cond.notify_all(); }
+        if (worker.joinable()) worker.join();
+      }
+      void event(const char* name, Clock::time_point begin, Clock::time_point end) {
+        if (profileState.load(std::memory_order_relaxed) != 1) return;
+        if (end - origin >= std::chrono::seconds(180)) {
+          profileState.store(0); cond.notify_all(); return;
+        }
+        // Producers never wait for disk or a contended profiling lock.
+        std::unique_lock<dxvk::mutex> guard(lock, std::try_to_lock);
+        if (!guard.owns_lock() || pending.size() >= 8192) { ++dropped; return; }
+        pending.push_back({ name, this_thread::get_id(),
+          std::chrono::duration_cast<std::chrono::microseconds>(begin - origin).count(),
+          std::chrono::duration_cast<std::chrono::microseconds>(end - begin).count() });
+      }
+    private:
+      std::ofstream file;
+      dxvk::mutex lock;
+      dxvk::condition_variable cond;
+      dxvk::thread worker;
+      std::vector<Event> pending;
+      std::atomic<uint64_t> dropped { 0 };
+      bool stop = false;
+      void write() {
+        env::setThreadName("w101-timing-writer");
+        ::SetThreadPriority(::GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+        std::vector<Event> batch; batch.reserve(8192);
+        size_t bytes = 34;
+        for (;;) {
+          std::unique_lock<dxvk::mutex> guard(lock);
+          cond.wait_until(guard, std::min(origin + std::chrono::seconds(180),
+            Clock::now() + std::chrono::milliseconds(250)), [this] { return stop || profileState.load() != 1; });
+          bool done = stop || profileState.load() != 1 || Clock::now() - origin >= std::chrono::seconds(180);
+          if (done) profileState.store(0);
+          pending.swap(batch);
+          guard.unlock();
+          for (const auto& event : batch) {
+            const auto row = std::string(event.name) + "," + std::to_string(event.tid) + ","
+              + std::to_string(event.start) + "," + std::to_string(event.duration) + "\n";
+            if (bytes + row.size() + 128 > 64u * 1024u * 1024u) { profileState.store(0); done = true; break; }
+            file << row; bytes += row.size();
+          }
+          batch.clear(); file.flush();
+          if (!file) { profileState.store(0); return; }
+          if (done) { file << "# dropped_events=" << dropped.load() << "\n"; file.flush(); return; }
+        }
+      }
+    };
+    // Do not join a thread from a DLL static destructor under Wine's loader
+    // lock. Drain on the last orderly device shutdown. Abrupt process exit
+    // keeps already-flushed batches and lets the OS reclaim this recorder.
+    Recorder& recorder() { static Recorder* instance = new Recorder(); return *instance; }
+    std::atomic<uint32_t> devices { 0 };
+  }
+  void profileDeviceCreated() { ++devices; }
+  void profileDeviceDestroyed() { if (devices.fetch_sub(1) == 1) recorder().shutdown(); }
+  void profileShutdown() { recorder().shutdown(); }
+  bool profileInitialize() {
+    recorder();
+    return profileState.load(std::memory_order_relaxed) == 1;
+  }
+  void profileEvent(const char* name, Clock::time_point begin, Clock::time_point end) {
+    recorder().event(name, begin, end);
+  }
+}
diff --git a/src/util/util_profile.h b/src/util/util_profile.h
new file mode 100644
index 00000000..6974e867
--- /dev/null
+++ b/src/util/util_profile.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+namespace dxvk {
+  // -1 requests lazy initialization; the steady disabled path is one load.
+  extern std::atomic<int32_t> profileState;
+  bool profileInitialize();
+  inline bool profileEnabled() {
+    const auto state = profileState.load(std::memory_order_relaxed);
+    return state < 0 ? profileInitialize() : state != 0;
+  }
+  void profileDeviceCreated();
+  void profileDeviceDestroyed();
+  void profileShutdown();
+  void profileEvent(const char* name, std::chrono::steady_clock::time_point begin,
+    std::chrono::steady_clock::time_point end);
+  class ProfileScope {
+    const char* m_name;
+    std::chrono::steady_clock::time_point m_begin;
+  public:
+    explicit ProfileScope(const char* name) : m_name(profileEnabled() ? name : nullptr) {
+      if (m_name) m_begin = std::chrono::steady_clock::now();
+    }
+    ~ProfileScope() {
+      if (m_name) profileEvent(m_name, m_begin, std::chrono::steady_clock::now());
+    }
+  };
+}
