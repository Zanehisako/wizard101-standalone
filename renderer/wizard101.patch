+  VkResult DxvkPipelineCache::createGraphics(const VkGraphicsPipelineCreateInfo* info, VkPipeline* pipeline) {
+    ProfileScope timing("graphics_pipeline_driver_compile");
+    std::shared_lock<std::shared_mutex> lock(m_gate, std::try_to_lock);
+    // A snapshot must never stall a required draw. The uncached pipeline
+    // still enters the normal instance table and retains draw ordering.
+    const auto cache = lock.owns_lock() && !m_bypass.load() ? m_cache : VK_NULL_HANDLE;
+    VkResult status = m_vkd->vkCreateGraphicsPipelines(m_vkd->device(), cache, 1, info, nullptr, pipeline);
+    if (status != VK_SUCCESS && cache) {
+      if (!m_bypass.exchange(true)) Logger::warn("W101 cached pipeline failed; retrying without cache");
+      if (*pipeline) m_vkd->vkDestroyPipeline(m_vkd->device(), *pipeline, nullptr);
+      *pipeline = VK_NULL_HANDLE;
+      status = m_vkd->vkCreateGraphicsPipelines(m_vkd->device(), VK_NULL_HANDLE, 1, info, nullptr, pipeline);
+    }
+    if (cache && status == VK_SUCCESS) changed();
+    return status;
+  }
+
+  VkResult DxvkPipelineCache::createCompute(const VkComputePipelineCreateInfo* info, VkPipeline* pipeline) {
+    ProfileScope timing("compute_pipeline_driver_compile");
+    std::shared_lock<std::shared_mutex> lock(m_gate, std::try_to_lock);
+    // A snapshot must never stall a required draw. The uncached pipeline
+    // still enters the normal instance table and retains draw ordering.
+    const auto cache = lock.owns_lock() && !m_bypass.load() ? m_cache : VK_NULL_HANDLE;
+    VkResult status = m_vkd->vkCreateComputePipelines(m_vkd->device(), cache, 1, info, nullptr, pipeline);
+    if (status != VK_SUCCESS && cache) {
+      if (!m_bypass.exchange(true)) Logger::warn("W101 cached pipeline failed; retrying without cache");
+      if (*pipeline) m_vkd->vkDestroyPipeline(m_vkd->device(), *pipeline, nullptr);
+      *pipeline = VK_NULL_HANDLE;
+      status = m_vkd->vkCreateComputePipelines(m_vkd->device(), VK_NULL_HANDLE, 1, info, nullptr, pipeline);
+    }
+    if (cache && status == VK_SUCCESS) changed();
+    return status;
+  }
+
+  void DxvkPipelineCache::save(bool final) {
+    uint64_t generation;
+    { std::lock_guard<dxvk::mutex> lock(m_lock);
+      generation = m_generation;
+      if (generation == m_saved) return;
+    }
+    std::vector<char> data;
+    { std::unique_lock<std::shared_mutex> gate(m_gate, std::defer_lock);
+      if (final) gate.lock(); else if (!gate.try_lock()) return;
+      ProfileScope timing("pipeline_cache_snapshot");
+      size_t size = 0;
+      if (m_vkd->vkGetPipelineCacheData(m_vkd->device(), m_cache, &size, nullptr) != VK_SUCCESS
+       || size < sizeof(VkPipelineCacheHeaderVersionOne) || size > cachefile::MaxPayload) return;
+      data.resize(size);
+      if (m_vkd->vkGetPipelineCacheData(m_vkd->device(), m_cache, &size, data.data()) != VK_SUCCESS) return;
+      data.resize(size);
+    }
+    // The gate is released before hashing, disk writes and atomic replacement.
+    bool written;
+    { ProfileScope timing("pipeline_cache_file_write");
+      written = cachefile::write(m_path, m_key, data);
+    }
+    if (written) {
+      std::lock_guard<dxvk::mutex> lock(m_lock); m_saved = generation;
+      Logger::info(str::format("W101 pipeline cache saved: ", data.size(), " bytes"));
+    } else {
+      // Persistence failure never affects rendering; stop retrying this launch.
+      m_path.clear(); Logger::warn("W101 pipeline cache persistence unavailable");
+    }
+  }
+
+  void DxvkPipelineCache::writer() {
+    env::setThreadName("w101-pipeline-cache");
+    ::SetThreadPriority(::GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    try {
+      for (;;) {
+        std::unique_lock<dxvk::mutex> lock(m_lock);
+        // Stay asleep while clean or after a permanent storage failure.
+        m_cond.wait(lock, [this] { return m_stop || (!m_path.empty() && m_generation != m_saved); });
+        if (m_stop) break;
+        const auto last = m_last;
+        const auto deadline = last + std::chrono::seconds(5);
+        if (m_cond.wait_until(lock, deadline, [this, last] { return m_stop || m_last != last; }))
+          continue;
+        lock.unlock();
+        save(false);
+        lock.lock();
+        // A held gate, VK_INCOMPLETE or transient driver failure leaves it
+        // dirty. Bound retries without polling the clean state or spinning.
+        if (!m_stop && !m_path.empty() && m_generation != m_saved)
+          m_cond.wait_for(lock, std::chrono::seconds(1), [this, last] { return m_stop || m_last != last; });
+      }
+      if (!m_path.empty()) save(true);
+    } catch (const std::exception& e) { Logger::warn(str::format("W101 cache save failed: ", e.what())); }
+  }
+
+  void DxvkPipelineCache::stop() {
+    { std::lock_guard<dxvk::mutex> lock(m_lock); m_stop = true; m_cond.notify_all(); }
+    if (m_writer.joinable()) m_writer.join();
+  }
 }
