diff --git a/src/d3d9/wizard101_cursor.h b/src/d3d9/wizard101_cursor.h
new file mode 100644
index 00000000..dcfeeb84
--- /dev/null
+++ b/src/d3d9/wizard101_cursor.h
@@ -0,0 +1,114 @@
+#pragma once
+
+// Wizard101's hardware cursor bypasses IDirect3DDevice9::SetCursorProperties.
+// Scale the file-loaded custom cursor once, before the game owns its handle.
+// This changes only the main executable's import, never USER32 globally.
+#ifdef _WIN32
+#include <windows.h>
+#include <cstring>
+#include <cwchar>
+#include <mutex>
+
+namespace dxvk {
+namespace wizard101 {
+
+inline HCURSOR WINAPI LoadLargeCursor(LPCSTR filename) {
+  HCURSOR original = ::LoadCursorFromFileA(filename);
+  if (!original)
+    return nullptr;
+
+  ICONINFO info = {};
+  if (!::GetIconInfo(original, &info))
+    return original;
+  BITMAP bitmap = {};
+  bool color = info.hbmColor != nullptr;
+  bool valid = ::GetObjectW(color ? info.hbmColor : info.hbmMask,
+    sizeof(bitmap), &bitmap) != 0;
+  if (info.hbmColor) ::DeleteObject(info.hbmColor);
+  if (info.hbmMask) ::DeleteObject(info.hbmMask);
+  int width = bitmap.bmWidth;
+  int height = color ? bitmap.bmHeight : bitmap.bmHeight / 2;
+  if (!valid || width <= 0 || height <= 0 || width > 128 || height > 128)
+    return original;
+
+  HCURSOR scaled = static_cast<HCURSOR>(::CopyImage(original, IMAGE_CURSOR,
+    width * 2, height * 2, 0));
+  if (!scaled || scaled == original)
+    return original;
+  // Wine's CopyImage enlarges the bitmap but retains the original hotspot.
+  // Recreate with doubled coordinates so clicks stay on the visible tip.
+  ICONINFO scaledInfo = {};
+  if (!::GetIconInfo(scaled, &scaledInfo)) {
+    ::DestroyCursor(scaled);
+    return original;
+  }
+  scaledInfo.fIcon = FALSE;
+  scaledInfo.xHotspot = info.xHotspot * 2;
+  scaledInfo.yHotspot = info.yHotspot * 2;
+  HCURSOR result = static_cast<HCURSOR>(::CreateIconIndirect(&scaledInfo));
+  if (scaledInfo.hbmColor) ::DeleteObject(scaledInfo.hbmColor);
+  if (scaledInfo.hbmMask) ::DeleteObject(scaledInfo.hbmMask);
+  ::DestroyCursor(scaled);
+  if (!result)
+    return original;
+  ::DestroyCursor(original);
+  return result;
+}
+
+inline void InstallCursorHook() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    HMODULE module = ::GetModuleHandleW(nullptr);
+    wchar_t path[MAX_PATH] = {};
+    DWORD length = ::GetModuleFileNameW(module, path, MAX_PATH);
+    if (!length || length >= MAX_PATH)
+      return;
+    const wchar_t* filename = std::wcsrchr(path, L'\\');
+    filename = filename ? filename + 1 : path;
+    if (::_wcsicmp(filename, L"WizardGraphicalClient.exe"))
+      return;
+
+    auto base = reinterpret_cast<unsigned char*>(module);
+    auto dos = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE)
+      return;
+    auto nt = reinterpret_cast<IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE)
+      return;
+    auto directory = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+    if (!directory.VirtualAddress)
+      return;
+    auto imports = reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base + directory.VirtualAddress);
+    for (; imports->Name; ++imports) {
+      if (::_stricmp(reinterpret_cast<const char*>(base + imports->Name), "user32.dll")
+          || !imports->OriginalFirstThunk)
+        continue;
+      auto names = reinterpret_cast<IMAGE_THUNK_DATA*>(base + imports->OriginalFirstThunk);
+      auto slots = reinterpret_cast<IMAGE_THUNK_DATA*>(base + imports->FirstThunk);
+      for (; names->u1.AddressOfData; ++names, ++slots) {
+        if (IMAGE_SNAP_BY_ORDINAL(names->u1.Ordinal))
+          continue;
+        auto name = reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base + names->u1.AddressOfData);
+        if (std::strcmp(reinterpret_cast<const char*>(name->Name), "LoadCursorFromFileA"))
+          continue;
+        DWORD protection = 0;
+        if (!::VirtualProtect(&slots->u1.Function, sizeof(slots->u1.Function),
+                             PAGE_READWRITE, &protection)) {
+          Logger::warn("Wizard101 cursor: cannot install file-loader hook");
+          return;
+        }
+        ::InterlockedExchangePointer(reinterpret_cast<void* volatile*>(&slots->u1.Function),
+          reinterpret_cast<void*>(&LoadLargeCursor));
+        DWORD ignored = 0;
+        ::VirtualProtect(&slots->u1.Function, sizeof(slots->u1.Function), protection, &ignored);
+        Logger::info("Wizard101 cursor: custom cursor images enlarged 2x");
+        return;
+      }
+    }
+    Logger::warn("Wizard101 cursor: file-loader import not found");
+  });
+}
+
+}
+}
+#endif
