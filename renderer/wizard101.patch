+      info.initialDataSize = 0; info.pInitialData = nullptr;
+      status = m_vkd->vkCreatePipelineCache(m_vkd->device(), &info, nullptr, &m_cache);
+      data.clear();
+    }
+    if (status != VK_SUCCESS) {
+      m_cache = VK_NULL_HANDLE;
