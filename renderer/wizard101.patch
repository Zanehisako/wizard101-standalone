+  void DxvkPipelineCache::changed() {
+    if (!m_cache || m_bypass.load()) return;
+    std::lock_guard<dxvk::mutex> lock(m_lock);
+    ++m_generation; m_last = std::chrono::steady_clock::now();
+    m_cond.notify_one();
