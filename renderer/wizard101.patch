new file mode 100644
index 00000000..3285ac4f
--- /dev/null
+++ b/src/vulkan/vulkan_diagnostics.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <string>
+#include "vulkan_loader.h"
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+
+namespace dxvk::vk {
+  inline bool diagnosticsEnabled() {
+    return env::getEnvVar("DXVK_DIAGNOSTICS") == "1";
+  }
+
+  // Per-category process-wide limit; never changes the failing API result.
+  inline bool diagnosticBudget(std::atomic<uint32_t>& count, const char* category) {
+    uint32_t n = count.fetch_add(1, std::memory_order_relaxed);
+    if (n == 32)
+      Logger::warn(str::format("DXVK diagnostics: further ", category, " messages suppressed after 32 failures"));
+    return n < 32;
+  }
+
+  inline VKAPI_ATTR VkBool32 VKAPI_CALL diagnosticCallback(
+      VkDebugUtilsMessageSeverityFlagBitsEXT,
+      VkDebugUtilsMessageTypeFlagsEXT,
+      const VkDebugUtilsMessengerCallbackDataEXT* data,
+      void*) {
+    static std::atomic<uint32_t> messages { 0 };
+    if (diagnosticBudget(messages, "Vulkan/Metal compiler")) {
+      // Driver messages can contain Metal compilation errors. Bound their size.
+      std::string message = data && data->pMessage ? data->pMessage : "(empty)";
+      message.resize(std::min<size_t>(message.size(), 4096));
+      Logger::warn(str::format("Vulkan/Metal [", data ? data->messageIdNumber : 0, "]: ", message));
+    }
+    return VK_FALSE;
+  }
+
+  inline VkDebugUtilsMessengerCreateInfoEXT diagnosticMessengerInfo() {
+    VkDebugUtilsMessengerCreateInfoEXT info = {};
+    info.sType = VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT;
+    info.messageSeverity = VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT
+      | VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT;
+    info.messageType = VK_DEBUG_UTILS_MESSAGE_TYPE_GENERAL_BIT_EXT
+      | VK_DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT
+      | VK_DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT;
+    info.pfnUserCallback = diagnosticCallback;
+    return info;
+  }
+}
