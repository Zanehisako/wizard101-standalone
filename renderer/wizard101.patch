diff --git a/src/util/util_cache_file.h b/src/util/util_cache_file.h
new file mode 100644
index 00000000..d794aa00
--- /dev/null
+++ b/src/util/util_cache_file.h
@@ -0,0 +1,69 @@
+#pragma once
+#include <fstream>
+#include <vector>
+#include <cstdio>
+#include <cstdint>
+#include "sha1/sha1_util.h"
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace dxvk::cachefile {
+  // Envelope has no pointers; x64 little-endian version 1. SHA1 detects damage,
+  // not authenticity. Ignore abandoned .tmp files on reload.
+  struct Header {
+    uint32_t magic = 0x31435057, version = 1;
+    uint64_t size = 0;
+    Sha1Hash key, checksum;
+  };
+  constexpr size_t MaxFile = 64u * 1024u * 1024u;
+  constexpr size_t MaxPayload = MaxFile - sizeof(Header);
+
+  inline bool read(const std::string& path, const Sha1Hash& key, std::vector<char>& data) {
+    data.clear();
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file) return false;
+    const auto length = file.tellg();
+    if (length < std::streamoff(sizeof(Header)) || length > std::streamoff(MaxFile)) return false;
+    Header header;
+    file.seekg(0); file.read(reinterpret_cast<char*>(&header), sizeof(header));
+    if (!file || header.magic != 0x31435057 || header.version != 1 || header.key != key
+     || header.size != uint64_t(length) - sizeof(header)) return false;
+    data.resize(header.size);
+    file.read(data.data(), data.size());
+    if (!file || Sha1Hash::compute(data.data(), data.size()) != header.checksum) {
+      data.clear(); return false;
+    }
+    return true;
+  }
+
+  inline bool write(const std::string& path, const Sha1Hash& key, const std::vector<char>& data) {
+    if (data.size() > MaxPayload) return false;
+    Header header;
+    header.size = data.size(); header.key = key;
+    header.checksum = Sha1Hash::compute(data.data(), data.size());
+#ifdef _WIN32
+    const auto temp = path + "." + std::to_string(GetCurrentProcessId()) + "." + std::to_string(GetCurrentThreadId()) + ".tmp";
+    HANDLE file = CreateFileA(temp.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return false;
+    DWORD written;
+    bool ok = WriteFile(file, &header, sizeof(header), &written, nullptr) && written == sizeof(header);
+    if (ok) ok = WriteFile(file, data.data(), DWORD(data.size()), &written, nullptr) && written == data.size();
+    if (ok) ok = FlushFileBuffers(file);
+    CloseHandle(file);
+    if (ok) ok = MoveFileExA(temp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+    if (!ok) DeleteFileA(temp.c_str());
+    return ok;
+#else
+    const auto temp = path + "." + std::to_string(getpid()) + ".tmp";
+    { std::ofstream file(temp, std::ios::binary | std::ios::trunc);
+      file.write(reinterpret_cast<const char*>(&header), sizeof(header));
+      file.write(data.data(), data.size()); file.flush();
+      if (!file) { std::remove(temp.c_str()); return false; }
+    }
+    return std::rename(temp.c_str(), path.c_str()) == 0;
+#endif
+  }
+}
