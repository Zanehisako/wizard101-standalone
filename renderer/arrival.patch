+  void DxvkContext::copySceneMipChain(
+    const Rc<DxvkImage>& dstImage, const Rc<DxvkImage>& srcImage) {
+    // Callers validate identical static single-layer color chains, <=15 mips.
+    // One range transition and one multi-region copy avoid repeating barriers
+    // and resource tracking for each mip. Both images retain independent storage.
+    this->spillRenderPass(true);
+    const VkImageSubresourceRange range{VK_IMAGE_ASPECT_COLOR_BIT,0,dstImage->info().mipLevels,0,1};
+    this->prepareImage(m_execBarriers,dstImage,range);
+    this->prepareImage(m_execBarriers,srcImage,range);
+    if(m_execBarriers.isImageDirty(dstImage,range,DxvkAccess::Write)
+        || m_execBarriers.isImageDirty(srcImage,range,DxvkAccess::Read))
+      m_execBarriers.recordCommands(m_cmd);
+    const auto dstLayout=dstImage->pickLayout(VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    const auto srcLayout=srcImage->pickLayout(VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    m_execAcquires.accessImage(dstImage,range,VK_IMAGE_LAYOUT_UNDEFINED,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,0,dstLayout,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_WRITE_BIT);
+    if(srcLayout!=srcImage->info().layout)
+      m_execAcquires.accessImage(srcImage,range,srcImage->info().layout,
+        VK_PIPELINE_STAGE_TRANSFER_BIT,0,srcLayout,
+        VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_READ_BIT);
+    m_execAcquires.recordCommands(m_cmd);
+    std::array<VkImageCopy,15> regions{};
+    for(uint32_t mip=0;mip<dstImage->info().mipLevels;mip++) {
+      regions[mip].srcSubresource={VK_IMAGE_ASPECT_COLOR_BIT,mip,0,1};
+      regions[mip].dstSubresource=regions[mip].srcSubresource;
+      regions[mip].extent=dstImage->mipLevelExtent(mip);
+    }
+    m_cmd->cmdCopyImage(DxvkCmdBuffer::ExecBuffer,srcImage->handle(),srcLayout,
+      dstImage->handle(),dstLayout,dstImage->info().mipLevels,regions.data());
+    m_execBarriers.accessImage(dstImage,range,dstLayout,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_WRITE_BIT,
+      dstImage->info().layout,dstImage->info().stages,dstImage->info().access);
+    m_execBarriers.accessImage(srcImage,range,srcLayout,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,VK_ACCESS_TRANSFER_READ_BIT,
+      srcImage->info().layout,srcImage->info().stages,srcImage->info().access);
+    m_cmd->trackResource<DxvkAccess::Write>(dstImage);
+    m_cmd->trackResource<DxvkAccess::Read>(srcImage);
+  }
