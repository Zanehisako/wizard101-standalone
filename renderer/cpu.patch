diff --git a/src/util/util_cpu_opt.h b/src/util/util_cpu_opt.h
new file mode 100644
index 0000000..bc7e72f
--- /dev/null
+++ b/src/util/util_cpu_opt.h
@@ -0,0 +1,25 @@
+#pragma once
+#include "util_env.h"
+namespace dxvk {
+  enum class CpuOptimization { Off, Constants, Locking, Both };
+  inline CpuOptimization cpuOptimization() {
+    static const auto mode = [] {
+      const auto value = env::getEnvVar("DXVK_W101_CPU_OPT");
+      if (value == "constants") return CpuOptimization::Constants;
+      if (value == "locking") return CpuOptimization::Locking;
+      if (value == "both") return CpuOptimization::Both;
+      return CpuOptimization::Off;
+    }();
+    return mode;
+  }
+  inline const char* cpuOptimizationName() {
+    const char* names[] = { "off", "constants", "locking", "both" };
+    return names[unsigned(cpuOptimization())];
+  }
+  inline bool cpuConstantsOptimized() {
+    return cpuOptimization() == CpuOptimization::Constants || cpuOptimization() == CpuOptimization::Both;
+  }
+  inline bool cpuLockingOptimized() {
+    return cpuOptimization() == CpuOptimization::Locking || cpuOptimization() == CpuOptimization::Both;
+  }
+}
