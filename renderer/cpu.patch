@@ -0,0 +1,128 @@
+#pragma once
+#include "wizard101_io_profile.h"
+#include <d3dx9.h>
+namespace dxvk::wizard101 {
+  // Timing only: exactly forward every argument and result, including optional
+  // output pointers and the incoming/outgoing Win32 error. No asset identity.
+  template<typename F, typename... A>
+  HRESULT TimedTextureCall(const char* label, F fn, A... args) {
+    DWORD error = GetLastError(); HRESULT result;
+    { ProfileScope profile(label);
+      SetLastError(error); result = fn(args...); error = GetLastError();
+    }
+    SetLastError(error); return result;
+  }
+  inline decltype(&::D3DXCreateTextureFromFileInMemory) originalD3DXCreateTextureFromFileInMemory = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateTextureFromFileInMemory(struct IDirect3DDevice9 *device,
+        const void *srcdata, UINT srcdatasize, struct IDirect3DTexture9 **texture) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateTextureFromFileInMemory", originalD3DXCreateTextureFromFileInMemory, device, srcdata, srcdatasize, texture);
+  }
+  inline decltype(&::D3DXCreateCubeTextureFromFileInMemory) originalD3DXCreateCubeTextureFromFileInMemory = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateCubeTextureFromFileInMemory(struct IDirect3DDevice9 *device,
+        const void *srcdata, UINT srcdatasize, struct IDirect3DCubeTexture9 **cube) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateCubeTextureFromFileInMemory", originalD3DXCreateCubeTextureFromFileInMemory, device, srcdata, srcdatasize, cube);
+  }
+  inline decltype(&::D3DXCreateVolumeTextureFromFileInMemory) originalD3DXCreateVolumeTextureFromFileInMemory = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateVolumeTextureFromFileInMemory(struct IDirect3DDevice9 *device,
+        const void *srcdata, UINT srcdatasize, struct IDirect3DVolumeTexture9 **volume) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateVolumeTextureFromFileInMemory", originalD3DXCreateVolumeTextureFromFileInMemory, device, srcdata, srcdatasize, volume);
+  }
+  inline decltype(&::D3DXCreateTextureFromFileExA) originalD3DXCreateTextureFromFileExA = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateTextureFromFileExA(struct IDirect3DDevice9 *device, const char *srcfile,
+        UINT width, UINT height, UINT miplevels, DWORD usage, D3DFORMAT format,
+        D3DPOOL pool, DWORD filter, DWORD mipfilter, D3DCOLOR colorkey, D3DXIMAGE_INFO *srcinfo,
+        PALETTEENTRY *palette, struct IDirect3DTexture9 **texture) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateTextureFromFileExA", originalD3DXCreateTextureFromFileExA, device, srcfile, width, height, miplevels, usage, format, pool, filter, mipfilter, colorkey, srcinfo, palette, texture);
+  }
+  inline decltype(&::D3DXCreateCubeTextureFromFileExA) originalD3DXCreateCubeTextureFromFileExA = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateCubeTextureFromFileExA(struct IDirect3DDevice9 *device, const char *srcfile,
+        UINT size, UINT miplevels, DWORD usage, D3DFORMAT format,
+        D3DPOOL pool, DWORD filter, DWORD mipfilter, D3DCOLOR colorkey, D3DXIMAGE_INFO *srcinfo,
+        PALETTEENTRY *palette, struct IDirect3DCubeTexture9 **cube) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateCubeTextureFromFileExA", originalD3DXCreateCubeTextureFromFileExA, device, srcfile, size, miplevels, usage, format, pool, filter, mipfilter, colorkey, srcinfo, palette, cube);
+  }
+  inline decltype(&::D3DXCreateVolumeTextureFromFileExA) originalD3DXCreateVolumeTextureFromFileExA = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateVolumeTextureFromFileExA(struct IDirect3DDevice9 *device, const char *srcfile,
+        UINT width, UINT height, UINT depth, UINT miplevels, DWORD usage, D3DFORMAT format,
+        D3DPOOL pool, DWORD filter, DWORD mipfilter, D3DCOLOR colorkey, D3DXIMAGE_INFO *srcinfo,
+        PALETTEENTRY *palette, struct IDirect3DVolumeTexture9 **volume) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateVolumeTextureFromFileExA", originalD3DXCreateVolumeTextureFromFileExA, device, srcfile, width, height, depth, miplevels, usage, format, pool, filter, mipfilter, colorkey, srcinfo, palette, volume);
+  }
+  inline decltype(&::D3DXCreateTexture) originalD3DXCreateTexture = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateTexture(struct IDirect3DDevice9 *device, UINT width, UINT height,
+        UINT miplevels, DWORD usage, D3DFORMAT format, D3DPOOL pool, struct IDirect3DTexture9 **texture) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateTexture", originalD3DXCreateTexture, device, width, height, miplevels, usage, format, pool, texture);
+  }
+  inline decltype(&::D3DXCreateTextureFromFileInMemoryEx) originalD3DXCreateTextureFromFileInMemoryEx = nullptr;
+  inline HRESULT WINAPI TimedD3DXCreateTextureFromFileInMemoryEx(struct IDirect3DDevice9 *device, const void *srcdata,
+        UINT srcdatasize, UINT width, UINT height, UINT miplevels, DWORD usage, D3DFORMAT format,
+        D3DPOOL pool, DWORD filter, DWORD mipfilter, D3DCOLOR colorkey, D3DXIMAGE_INFO *srcinfo,
+        PALETTEENTRY *palette, struct IDirect3DTexture9 **texture) {
+    return TimedTextureCall("game_d3dx_texture_D3DXCreateTextureFromFileInMemoryEx", originalD3DXCreateTextureFromFileInMemoryEx, device, srcdata, srcdatasize, width, height, miplevels, usage, format, pool, filter, mipfilter, colorkey, srcinfo, palette, texture);
+  }
+  inline void InstallTextureProfileHooks() {
+    if (env::getExeName() != "WizardGraphicalClient.exe" || !profileEnabled()) return;
+    static std::once_flag installed;
+    std::call_once(installed, [] {
+      auto base = reinterpret_cast<unsigned char*>(GetModuleHandleW(nullptr));
+      if (!base) return;
+      auto dos = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+      if (dos->e_magic != IMAGE_DOS_SIGNATURE) return;
+      auto nt = reinterpret_cast<IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+      if (nt->Signature != IMAGE_NT_SIGNATURE) return;
+      const auto dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+      if (!dir.VirtualAddress) return;
+      auto imports = reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base + dir.VirtualAddress);
+      unsigned count = 0;
+      for (; imports->Name; ++imports) {
+        if (_stricmp(reinterpret_cast<const char*>(base + imports->Name), "d3dx9_43.dll")) continue;
+        const auto module = GetModuleHandleA("d3dx9_43.dll");
+        if (!module) continue;
+        auto slots = reinterpret_cast<IMAGE_THUNK_DATA*>(base + imports->FirstThunk);
+        // Wizard101 imports these exports by ordinal. Match the resolved target
+        // against the loaded version's named export, never hardcode ordinals.
+        for (; slots->u1.Function; ++slots) {
+          void* replacement = nullptr;
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateTextureFromFileInMemory"))) {
+            originalD3DXCreateTextureFromFileInMemory = reinterpret_cast<decltype(originalD3DXCreateTextureFromFileInMemory)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateTextureFromFileInMemory);
+          }
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateCubeTextureFromFileInMemory"))) {
+            originalD3DXCreateCubeTextureFromFileInMemory = reinterpret_cast<decltype(originalD3DXCreateCubeTextureFromFileInMemory)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateCubeTextureFromFileInMemory);
+          }
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateVolumeTextureFromFileInMemory"))) {
+            originalD3DXCreateVolumeTextureFromFileInMemory = reinterpret_cast<decltype(originalD3DXCreateVolumeTextureFromFileInMemory)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateVolumeTextureFromFileInMemory);
+          }
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateTextureFromFileExA"))) {
+            originalD3DXCreateTextureFromFileExA = reinterpret_cast<decltype(originalD3DXCreateTextureFromFileExA)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateTextureFromFileExA);
+          }
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateCubeTextureFromFileExA"))) {
+            originalD3DXCreateCubeTextureFromFileExA = reinterpret_cast<decltype(originalD3DXCreateCubeTextureFromFileExA)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateCubeTextureFromFileExA);
+          }
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateVolumeTextureFromFileExA"))) {
+            originalD3DXCreateVolumeTextureFromFileExA = reinterpret_cast<decltype(originalD3DXCreateVolumeTextureFromFileExA)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateVolumeTextureFromFileExA);
+          }
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateTexture"))) {
+            originalD3DXCreateTexture = reinterpret_cast<decltype(originalD3DXCreateTexture)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateTexture);
+          }
+          if (slots->u1.Function == reinterpret_cast<ULONG_PTR>(GetProcAddress(module, "D3DXCreateTextureFromFileInMemoryEx"))) {
+            originalD3DXCreateTextureFromFileInMemoryEx = reinterpret_cast<decltype(originalD3DXCreateTextureFromFileInMemoryEx)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedD3DXCreateTextureFromFileInMemoryEx);
+          }
+          if (!replacement) continue;
+          DWORD protection, ignored;
+          if (!VirtualProtect(&slots->u1.Function, sizeof(slots->u1.Function), PAGE_READWRITE, &protection)) continue;
+          InterlockedExchangePointer(reinterpret_cast<void* volatile*>(&slots->u1.Function), replacement);
+          VirtualProtect(&slots->u1.Function, sizeof(slots->u1.Function), protection, &ignored); ++count;
+        }
+      }
+      Logger::info(str::format("W101 profiling: installed ", count, " game D3DX texture hooks"));
+    });
+  }
+}
