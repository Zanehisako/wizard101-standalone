+  // Compare effective values, using exactly the same float emulation as the
+  // existing updater. Bit equality preserves signed zero and raw NaN payloads.
+  // Called only after validation/clamping and state-block recording.
+  template<DxsoProgramType ProgramType, D3D9ConstantType ConstantType, typename T, typename StateType>
+  bool StateConstantsUnchanged(StateType* state, UINT start, const T* data, UINT count, bool floatEmu) {
+    auto same = [&](auto& set) {
+      if constexpr (ConstantType == D3D9ConstantType::Float) {
+        if (!floatEmu) return !std::memcmp(set->fConsts[start].data, data, count * sizeof(Vector4));
+        for (UINT i = 0; i < count; ++i) {
+          const auto effective = replaceNaN(data + i * 4);
+          if (std::memcmp(set->fConsts[start + i].data, effective.data, sizeof(Vector4))) return false;
+        }
+        return true;
+      } else if constexpr (ConstantType == D3D9ConstantType::Int) {
+        return !std::memcmp(set->iConsts[start].data, data, count * sizeof(Vector4i));
+      } else {
+        for (UINT i = 0; i < count; ++i) {
+          const UINT index = start + i;
+          if (bool(set->bConsts[index / 32] & (1u << (index % 32))) != bool(data[i])) return false;
+        }
+        return true;
+      }
+    };
+    return ProgramType == DxsoProgramTypes::VertexShader ? same(state->vsConsts) : same(state->psConsts);
+  }
+
