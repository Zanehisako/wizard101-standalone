diff --git a/src/util/util_pipeline_opt.h b/src/util/util_pipeline_opt.h
new file mode 100644
--- /dev/null
+++ b/src/util/util_pipeline_opt.h
@@ -0,0 +1,30 @@
+#pragma once
+#include "util_env.h"
+#include "log/log.h"
+
+namespace dxvk {
+  enum class W101PipelineOpt { Off, Replay, Lookup, Both };
+  inline W101PipelineOpt parsePipelineOpt(const std::string& value) {
+    if (value == "replay") return W101PipelineOpt::Replay;
+    if (value == "lookup") return W101PipelineOpt::Lookup;
+    if (value == "both") return W101PipelineOpt::Both;
+    return W101PipelineOpt::Off;
+  }
+  inline W101PipelineOpt pipelineOpt() {
+    static const auto mode = [] {
+      const auto value = env::getEnvVar("DXVK_W101_PIPELINE_OPT");
+      if (!value.empty() && value != "off" && value != "replay" && value != "lookup" && value != "both")
+        Logger::warn("W101 invalid pipeline optimization mode; using off");
+      const auto parsed = parsePipelineOpt(value);
+      Logger::info("W101 pipeline optimizations: " + (parsed == W101PipelineOpt::Off ? std::string("off") : value));
+      return parsed;
+    }();
+    return mode;
+  }
+  inline bool replayOpt() {
+    return pipelineOpt() == W101PipelineOpt::Replay || pipelineOpt() == W101PipelineOpt::Both;
+  }
+  inline bool lookupOpt() {
+    return pipelineOpt() == W101PipelineOpt::Lookup || pipelineOpt() == W101PipelineOpt::Both;
+  }
+}
