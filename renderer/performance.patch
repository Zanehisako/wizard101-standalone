+  // Instances and index nodes live until the owning pipeline is destroyed.
+  // Readers acquire immutable nodes; only the compilation mutex admits writers.
+  class DxvkGraphicsPipelineLookup {
+  public:
+    static size_t bucket(const DxvkGraphicsPipelineStateInfo& state, const DxvkRenderPass* pass) {
+      // Equality compares every packed byte, including reserved bytes.
+      uint64_t hash = 0xcbf29ce484222325ull;
+      const auto bytes = reinterpret_cast<const unsigned char*>(&state);
+      for (size_t i = 0; i < sizeof(state); i += sizeof(uint64_t)) {
+        uint64_t word;
+        std::memcpy(&word, bytes + i, sizeof(word));
+        hash = (hash ^ word) * 0x100000001b3ull;
+        hash ^= hash >> 32;
+      }
+      hash = (hash ^ reinterpret_cast<uintptr_t>(pass)) * 0x100000001b3ull;
+      return (hash ^ (hash >> 32)) & 63;
+    }
+    DxvkGraphicsPipelineInstance* find(const DxvkGraphicsPipelineStateInfo& state, const DxvkRenderPass* pass) {
+      auto last = m_last.load(std::memory_order_acquire);
+      if (last && last->isCompatible(state, pass)) return last;
+      for (auto instance : m_buckets[bucket(state, pass)]) {
+        if (instance->isCompatible(state, pass)) {
+          m_last.store(instance, std::memory_order_release);
+          return instance;
+        }
+      }
+      return nullptr;
+    }
+    void publish(DxvkGraphicsPipelineInstance* instance, const DxvkGraphicsPipelineStateInfo& state, const DxvkRenderPass* pass) {
+      m_buckets[bucket(state, pass)].insert(instance);
+      m_last.store(instance, std::memory_order_release);
+    }
+  private:
+    std::atomic<DxvkGraphicsPipelineInstance*> m_last { nullptr };
+    std::array<sync::List<DxvkGraphicsPipelineInstance*>, 64> m_buckets;
+  };
