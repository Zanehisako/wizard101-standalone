diff --git a/src/util/util_pipeline_compile.h b/src/util/util_pipeline_compile.h
new file mode 100644
index 0000000..c5c6623
--- /dev/null
+++ b/src/util/util_pipeline_compile.h
@@ -0,0 +1,75 @@
+#pragma once
+#include "thread.h"
+#include "util_env.h"
+#include <exception>
+#include <memory>
+#include <unordered_map>
+
+namespace dxvk {
+  inline bool w101StutterFix() {
+    return env::getEnvVar("DXVK_W101_STUTTER_FIX") == "1";
+  }
+
+  // Only table access and publication hold the lock. Each exact state/pass
+  // shares one result, including null handles and exceptions. Unrelated states
+  // enter the driver concurrently; its own cache/Metal locks remain intact.
+  template<typename State, typename Result>
+  class PipelineCompilation {
+    struct Key {
+      State state;
+      const void* pass;
+      bool operator == (const Key& other) const {
+        return pass == other.pass && state == other.state;
+      }
+    };
+    struct Hash {
+      size_t operator () (const Key& key) const {
+        // These packed states use complete byte equality, including their
+        // zero-initialized padding. Hash collisions still require exact equality.
+        size_t hash = 2166136261u;
+        const auto bytes = reinterpret_cast<const unsigned char*>(&key.state);
+        for (size_t i = 0; i < sizeof(State); ++i) hash = (hash ^ bytes[i]) * 16777619u;
+        return hash ^ std::hash<const void*>()(key.pass);
+      }
+    };
+    struct Entry {
+      dxvk::condition_variable ready;
+      bool complete = false;
+      Result result = {};
+      std::exception_ptr failure;
+    };
+    dxvk::mutex m_lock;
+    std::unordered_map<Key, std::shared_ptr<Entry>, Hash> m_states;
+  public:
+    template<typename Compile>
+    Result get(const State& state, const void* pass, Compile&& compile, bool* created = nullptr) {
+      std::shared_ptr<Entry> entry;
+      {
+        std::unique_lock<dxvk::mutex> lock(m_lock);
+        auto found = m_states.find(Key { state, pass });
+        if (found != m_states.end()) {
+          entry = found->second;
+          entry->ready.wait(lock, [&] { return entry->complete; });
+          if (created) *created = false;
+          if (entry->failure) std::rethrow_exception(entry->failure);
+          return entry->result;
+        }
+        entry = std::make_shared<Entry>();
+        m_states.emplace(Key { state, pass }, entry);
+      }
+      Result result = {};
+      std::exception_ptr failure;
+      try { result = compile(); } catch (...) { failure = std::current_exception(); }
+      {
+        std::lock_guard<dxvk::mutex> lock(m_lock);
+        entry->result = result;
+        entry->failure = failure;
+        entry->complete = true;
+        entry->ready.notify_all();
+      }
+      if (created) *created = true;
+      if (failure) std::rethrow_exception(failure);
+      return result;
+    }
+  };
+}
