diff --git a/src/d3d9/wizard101_io_profile.h b/src/d3d9/wizard101_io_profile.h
new file mode 100644
index 0000000..90f5b7b
--- /dev/null
+++ b/src/d3d9/wizard101_io_profile.h
@@ -0,0 +1,74 @@
+#pragma once
+#include "../util/util_profile.h"
+#include "../util/util_env.h"
+#include "../util/log/log.h"
+#include <windows.h>
+#include <cstring>
+#include <mutex>
+
+namespace dxvk::wizard101 {
+  // Opt-in timings of the game's own disk/stream reads. No filenames, file
+  // contents, handles, network payloads or credentials are recorded. Mapped
+  // file faults, decompression and game-side work remain outside this capture.
+  inline decltype(&::ReadFile) gameReadFile = nullptr;
+  using InternetRead = BOOL (WINAPI*)(HANDLE, LPVOID, DWORD, LPDWORD);
+  inline InternetRead gameInternetRead = nullptr;
+  inline BOOL WINAPI TimedReadFile(HANDLE file, LPVOID buffer, DWORD bytes,
+    LPDWORD read, LPOVERLAPPED overlapped) {
+    DWORD error = GetLastError(); BOOL result;
+    { ProfileScope profile("game_read_file");
+      SetLastError(error); result = gameReadFile(file, buffer, bytes, read, overlapped);
+      error = GetLastError();
+    }
+    SetLastError(error); return result;
+  }
+  inline BOOL WINAPI TimedInternetRead(HANDLE file, LPVOID buffer, DWORD bytes, LPDWORD read) {
+    DWORD error = GetLastError(); BOOL result;
+    { ProfileScope profile("game_stream_read");
+      SetLastError(error); result = gameInternetRead(file, buffer, bytes, read);
+      error = GetLastError();
+    }
+    SetLastError(error); return result;
+  }
+  inline void InstallIoProfileHooks() {
+    if (env::getExeName() != "WizardGraphicalClient.exe" || !profileEnabled()) return;
+    static std::once_flag installed;
+    std::call_once(installed, [] {
+      auto base = reinterpret_cast<unsigned char*>(GetModuleHandleW(nullptr));
+      auto dos = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+      if (!base || dos->e_magic != IMAGE_DOS_SIGNATURE) return;
+      auto nt = reinterpret_cast<IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+      if (nt->Signature != IMAGE_NT_SIGNATURE) return;
+      const auto dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+      if (!dir.VirtualAddress) return;
+      auto imports = reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base + dir.VirtualAddress);
+      uint32_t count = 0;
+      for (; imports->Name; ++imports) {
+        if (!imports->OriginalFirstThunk) continue;
+        const auto dll = reinterpret_cast<const char*>(base + imports->Name);
+        const bool kernel = !_stricmp(dll, "kernel32.dll"), internet = !_stricmp(dll, "wininet.dll");
+        if (!kernel && !internet) continue;
+        auto names = reinterpret_cast<IMAGE_THUNK_DATA*>(base + imports->OriginalFirstThunk);
+        auto slots = reinterpret_cast<IMAGE_THUNK_DATA*>(base + imports->FirstThunk);
+        for (; names->u1.AddressOfData; ++names, ++slots) {
+          if (IMAGE_SNAP_BY_ORDINAL(names->u1.Ordinal)) continue;
+          const auto name = reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base + names->u1.AddressOfData);
+          void* replacement = nullptr;
+          if (kernel && !strcmp(reinterpret_cast<const char*>(name->Name), "ReadFile")) {
+            gameReadFile = reinterpret_cast<decltype(gameReadFile)>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedReadFile);
+          } else if (internet && !strcmp(reinterpret_cast<const char*>(name->Name), "InternetReadFile")) {
+            gameInternetRead = reinterpret_cast<InternetRead>(slots->u1.Function);
+            replacement = reinterpret_cast<void*>(&TimedInternetRead);
+          }
+          if (!replacement) continue;
+          DWORD protection, ignored;
+          if (!VirtualProtect(&slots->u1.Function, sizeof(slots->u1.Function), PAGE_READWRITE, &protection)) continue;
+          InterlockedExchangePointer(reinterpret_cast<void* volatile*>(&slots->u1.Function), replacement);
+          VirtualProtect(&slots->u1.Function, sizeof(slots->u1.Function), protection, &ignored); ++count;
+        }
+      }
+      Logger::info(str::format("W101 profiling: installed ", count, " game read hooks"));
+    });
+  }
+}
