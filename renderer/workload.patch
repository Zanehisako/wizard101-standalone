+  static ProfileContext captureIdentity(const DxvkGraphicsPipelineShaders& shaders,
+      const DxvkGraphicsPipelineStateInfo& state, const DxvkRenderPass* pass, const char* role) {
+    if (!profileEnabled()) return ProfileContext({}, {}, {}, role);
+    std::string keys, coverage;
+    for (const auto& shader : {shaders.vs, shaders.tcs, shaders.tes, shaders.gs, shaders.fs}) {
+      if (shader == nullptr) continue;
+      const auto key = shader->getShaderKey().toString();
+      keys += (keys.empty() ? "" : ";") + key;
+      coverage += (coverage.empty() ? "" : ";") + profileShaderCoverage(key);
+    }
+    const auto format = pass->format();
+    // State vectors are the packed bytes used by the renderer's own equality.
+    // Serialize attachment fields explicitly; no render-pass pointer/padding.
+    std::string attachments = str::format(format.sampleCount, ":", format.depth.format, ":", format.depth.layout);
+    for (auto color : format.color) attachments += str::format(":", color.format, ":", color.layout);
+    const Sha1Data parts[] = {{keys.data(), keys.size()}, {&state, sizeof(state)}, {attachments.data(), attachments.size()}};
+    return ProfileContext(Sha1Hash::compute(3, parts).toString(), keys, coverage, role);
+  }
 
